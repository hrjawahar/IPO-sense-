{
  "name": "IPO Sense",
  "short_name": "IPO Sense",
  "description": "Score Indian IPOs, plan listing-day exits, track GMP and learn the basics.",
  "id": "./",
  "start_url": "./#score",
  "scope": "./",
  "display": "standalone",
  "background_color": "#EDF2EE",
  "theme_color": "#0E6A56",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [ { "name": "shots", "accept": ["image/*"] } ]
    }
  }
}
